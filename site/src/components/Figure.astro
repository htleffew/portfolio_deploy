---
import fs from 'node:fs';
import path from 'node:path';

export interface Props {
  src: string;
  alt?: string;
  caption?: string;
}
const { src, alt = "", caption } = Astro.props;

// For SVG figures, inline the markup at build time so the diagram is part of the
// page DOM and inherits the live design tokens (var(--phthalo), etc.) from
// tokens.css — keeping every figure on the same variable system as the rest of
// the site. An <img>-loaded SVG can't see page CSS variables, so we only fall
// back to <img> for raster images or if the file can't be read.
let inlineSvg = "";
if (src && src.toLowerCase().endsWith(".svg")) {
  try {
    const filePath = path.join(process.cwd(), "public", src.replace(/^\/+/, ""));
    inlineSvg = fs.readFileSync(filePath, "utf8");
  } catch {
    inlineSvg = "";
  }
}
---
<div class="figure reveal">
  <div class="frame">
    {inlineSvg
      ? <Fragment set:html={inlineSvg} />
      : <img src={src} alt={alt} />}
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</div>
