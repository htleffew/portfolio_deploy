---
// Mutation Boundary Simulator (autoresearch-master).
// Self-contained port of the original interactive_0.js — bundled page-chrome
// removed, mojibake arrows/minus fixed, logic wired by scoped listeners instead
// of global onclick. Demonstrates a finite Mutation Budget: hyperparameter and
// feature mutations spend budget; a Fixed-Harness violation (disabling the PII
// filter) trips an immediate halt.
---
<div class="mbs reveal" role="group" aria-label="Mutation budget simulator">
  <div class="mbs-head">
    <span class="mbs-eyebrow">Autonomous research loop</span>
    <span class="mbs-val" id="budget-val">100 / 100</span>
  </div>
  <div class="mbs-track"><div class="mbs-bar" id="budget-bar"></div></div>
  <div class="mbs-controls">
    <button class="mbs-btn" id="btn-hyper" type="button">Hyperparameter mutation <span class="mbs-cost">−10</span></button>
    <button class="mbs-btn" id="btn-feature" type="button">Feature engineering <span class="mbs-cost">−20</span></button>
    <button class="mbs-btn mbs-btn--danger" id="btn-pii" type="button">Disable PII filter <span class="mbs-cost">violation</span></button>
    <button class="mbs-btn mbs-btn--ghost" id="btn-reset" type="button">Reset</button>
  </div>
  <div class="mbs-log" id="sim-log" aria-live="polite"></div>
</div>

<style>
  .mbs {
    border: 1px solid var(--brushed);
    background: var(--obsidian);
    padding: 1.5rem;
    margin: 2.5rem 0;
    font-family: var(--font-mono, ui-monospace, monospace);
  }
  .mbs-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.75rem; }
  .mbs-eyebrow { color: var(--tungsten); font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase; }
  .mbs-val { color: var(--platinum); font-size: 0.95rem; font-variant-numeric: tabular-nums; }
  .mbs-track { height: 14px; background: rgba(255,255,255,0.06); border: 1px solid var(--brushed); overflow: hidden; }
  .mbs-bar { height: 100%; width: 100%; background: var(--phthalo-lift); transition: width 0.4s ease, background 0.4s ease; }
  .mbs-controls { display: flex; flex-wrap: wrap; gap: 0.6rem; margin: 1rem 0; }
  .mbs-btn {
    font-family: inherit; font-size: 0.78rem; letter-spacing: 0.03em;
    color: var(--platinum); background: rgba(56,102,160,0.12);
    border: 1px solid var(--phthalo-lift); padding: 0.55rem 0.9rem; cursor: pointer;
    transition: background 0.2s ease, opacity 0.2s ease;
  }
  .mbs-btn:hover { background: rgba(56,102,160,0.28); }
  .mbs-btn .mbs-cost { color: var(--tungsten); margin-left: 0.4rem; }
  .mbs-btn--danger { border-color: var(--alizarin); background: rgba(122,22,38,0.15); }
  .mbs-btn--danger:hover { background: rgba(122,22,38,0.32); }
  .mbs-btn--ghost { border-color: var(--brushed); background: transparent; color: var(--tungsten); }
  .mbs-btn.is-disabled { opacity: 0.35; pointer-events: none; }
  .mbs-log {
    height: 180px; overflow-y: auto; background: rgba(0,0,0,0.35);
    border: 1px solid var(--brushed); padding: 0.75rem; font-size: 0.78rem; line-height: 1.7;
  }
  .mbs-log .log-entry { color: var(--tungsten); white-space: pre-wrap; }
  .mbs-log .is-success { color: var(--phthalo-lift); }
  .mbs-log .is-alert { color: var(--alizarin); }
</style>

<script>
  (function () {
    const bar = document.getElementById('budget-bar');
    const val = document.getElementById('budget-val');
    const log = document.getElementById('sim-log');
    if (!bar || !val || !log) return;

    const TOTAL = 100;
    let budget = TOTAL, halted = false, mutationCount = 0;

    const hyperMsgs = [
      'Adjusted RandomForest n_estimators: 150 → 220',
      'Tuned XGBoost learning_rate: 0.1 → 0.05',
      'Set regularization lambda: 0.01 → 0.1',
      'Switched max_depth: 6 → 8',
      'Reduced min_samples_split: 5 → 3',
    ];
    const featureMsgs = [
      'Engineered polynomial feature: cohort_age^2 x tenure',
      'Created interaction term: segment_id x quarterly_revenue',
      'Applied log transform to skewed_metric_3',
      'Binned continuous variable: response_latency → quartile buckets',
      'Derived rolling 90-day average for engagement_score',
    ];
    const btns = ['btn-hyper', 'btn-feature', 'btn-pii'];

    function addLog(msg, cls) {
      const el = document.createElement('div');
      el.className = 'log-entry' + (cls ? ' ' + cls : '');
      el.textContent = msg;
      log.appendChild(el);
      log.scrollTop = log.scrollHeight;
    }
    function updateBar() {
      bar.style.width = (budget / TOTAL) * 100 + '%';
      bar.style.background = budget < 20 ? 'var(--alizarin)' : budget < 40 ? 'var(--hansa, #E8A33D)' : 'var(--phthalo-lift)';
      val.textContent = budget + ' / ' + TOTAL;
    }
    function disableAll() { btns.forEach((id) => document.getElementById(id).classList.add('is-disabled')); }
    function enableAll() { btns.forEach((id) => document.getElementById(id).classList.remove('is-disabled')); }

    function mutate(type) {
      if (halted) return;
      const cost = type === 'hyper' ? 10 : 20;
      const msgs = type === 'hyper' ? hyperMsgs : featureMsgs;
      if (cost > budget) {
        budget = 0; halted = true; updateBar();
        addLog('[ HALT ] MUTATION BUDGET EXHAUSTED. Autonomous loop terminated.', 'is-alert');
        disableAll(); return;
      }
      budget -= cost; mutationCount++;
      addLog('[ MUT-' + String(mutationCount).padStart(2, '0') + ' ] ' + msgs[mutationCount % msgs.length] + ' (−' + cost + ')', 'is-success');
      updateBar();
      if (budget <= 0) { halted = true; addLog('[ HALT ] MUTATION BUDGET EXHAUSTED. Autonomous loop terminated.', 'is-alert'); disableAll(); }
    }
    function violate() {
      if (halted) return;
      halted = true; budget = 0; updateBar();
      addLog('[ !!!  ] FIXED HARNESS VIOLATION DETECTED', 'is-alert');
      addLog('[ HALT ] Agent attempted to disable PII redaction filter.', 'is-alert');
      addLog('[ HALT ] SYSTEM HALT: All mutation privileges revoked.', 'is-alert');
      disableAll();
    }
    function reset() {
      budget = TOTAL; halted = false; mutationCount = 0; updateBar();
      log.innerHTML = '';
      addLog('[ INIT ] Autonomous research loop initialized. Budget: 100/100.', 'is-success');
      enableAll();
    }

    document.getElementById('btn-hyper').addEventListener('click', () => mutate('hyper'));
    document.getElementById('btn-feature').addEventListener('click', () => mutate('feature'));
    document.getElementById('btn-pii').addEventListener('click', violate);
    document.getElementById('btn-reset').addEventListener('click', reset);
    reset();
  })();
</script>
