---
// Length-trap toggle for helper-language-signal. Each row is the correlation (r,
// 95% Fisher-z interval) between a dictionary category and attorney
// representation in the synthetic Population A (n = 5,000), measured two ways:
// any occurrence anywhere in the chat, or the rate per 100 words in turns 1 and 2.
// Values are copied from public/data/helper-language-signal/length_trap.json,
// produced by projects/research/helper-language-signal/simulate.py (seed 20261001).
const rows = [
  { key: "apology", label: "Apology", side: "helper", any: [0.289, 0.263, 0.314], rate: [0.179, 0.152, 0.205] },
  { key: "limitation", label: "Limitation", side: "helper", any: [0.259, 0.233, 0.284], rate: [0.116, 0.088, 0.143] },
  { key: "hedging", label: "Hedging (planted null)", side: "helper", any: [0.157, 0.130, 0.184], rate: [0.011, -0.017, 0.038] },
  { key: "negation", label: "Negation", side: "claimant", any: [0.219, 0.192, 0.245], rate: [0.057, 0.029, 0.085] },
  { key: "correction", label: "Correction", side: "claimant", any: [0.107, 0.080, 0.134], rate: [0.002, -0.026, 0.029] },
  { key: "anger", label: "Anger", side: "claimant", any: [0.109, 0.081, 0.136], rate: [0.018, -0.009, 0.046] },
  { key: "i", label: "First-person singular", side: "claimant", any: [0.110, 0.082, 0.137], rate: [0.032, 0.004, 0.059] },
];
const reference = {
  any: { label: "Turns in the chat", v: [0.416, 0.393, 0.439] },
  rate: { label: "Words in turns 1 and 2", v: [-0.019, -0.047, 0.009] },
};
const MIN = -0.05;
const MAX = 0.45;
const pos = (v: number) => ((v - MIN) / (MAX - MIN)) * 100;
const fmt = (v: number) => {
  const s = Math.abs(v).toFixed(2).replace(/^0/, "");
  return (v < -0.0049 ? "−" : "") + s;
};
const bar = (v: number[]) => {
  const left = pos(Math.min(0, v[0]));
  const width = Math.abs(pos(v[0]) - pos(0));
  return `left:${left.toFixed(2)}%;width:${width.toFixed(2)}%`;
};
const whisker = (v: number[]) => `left:${pos(v[1]).toFixed(2)}%;width:${(pos(v[2]) - pos(v[1])).toFixed(2)}%`;
const label = (v: number[]) => `r = ${fmt(v[0])} [${fmt(v[1])}, ${fmt(v[2])}]`;
const ticks = [0, 0.1, 0.2, 0.3, 0.4];
---
<figure class="hlt" data-hl-trap aria-label="Correlation of each dictionary category with attorney representation, measured two ways">
  <div class="hlt-toggle" role="group" aria-label="Measurement">
    <button type="button" class="hlt-btn" data-mode="any" aria-pressed="true">Any occurrence, whole chat</button>
    <button type="button" class="hlt-btn" data-mode="rate" aria-pressed="false">Rate per 100 words, turns 1 and 2</button>
  </div>

  <div class="hlt-axis" aria-hidden="true">
    <div></div>
    <div class="hlt-scale">
      {ticks.map((t) => (<span style={`left:${pos(t).toFixed(2)}%`}>{t === 0 ? "0" : fmt(t)}</span>))}
    </div>
    <div></div>
  </div>

  {rows.map((r) => (
    <div class="hlt-row" data-any={r.any.join(",")} data-rate={r.rate.join(",")}>
      <div class="hlt-label">{r.label}<small>{r.side === "helper" ? "Claim professional" : "Claimant"}</small></div>
      <div class="hlt-track">
        <span class="hlt-zero" style={`left:${pos(0).toFixed(2)}%`}></span>
        <span class:list={["hlt-bar", r.side]} style={bar(r.any)}></span>
        <span class="hlt-ci" style={whisker(r.any)}></span>
      </div>
      <div class="hlt-val">{label(r.any)}</div>
    </div>
  ))}

  <div class="hlt-row hlt-ref" data-any={reference.any.v.join(",")} data-rate={reference.rate.v.join(",")}
       data-label-any={reference.any.label} data-label-rate={reference.rate.label}>
    <div class="hlt-label"><span class="hlt-ref-label">{reference.any.label}</span><small>Reference, not a category</small></div>
    <div class="hlt-track">
      <span class="hlt-zero" style={`left:${pos(0).toFixed(2)}%`}></span>
      <span class="hlt-bar ref" style={bar(reference.any.v)}></span>
      <span class="hlt-ci" style={whisker(reference.any.v)}></span>
    </div>
    <div class="hlt-val">{label(reference.any.v)}</div>
  </div>

  <figcaption>
    <span class="hlt-note" data-note-any>Counted as any occurrence anywhere in the chat, every category correlates with representation, hedging included, though I planted hedging at a constant rate per sentence. A longer chat gives any word more chances to appear, and chat length correlates r = .42 with the outcome.</span>
    <span class="hlt-note" data-note-rate hidden>Counted as a rate per 100 words inside the first two turns, hedging falls to zero and the helper categories keep the signal I planted in them. The word count of that window shows no relation to the outcome (r = &minus;.02), so length has no route into the measure.</span>
    Correlations with attorney representation in 5,000 synthetic chats; whiskers are 95% intervals.
  </figcaption>
</figure>

<script>
  const MIN = -0.05;
  const MAX = 0.45;
  const pos = (v: number) => ((v - MIN) / (MAX - MIN)) * 100;
  const fmt = (v: number) => (v < -0.0049 ? "−" : "") + Math.abs(v).toFixed(2).replace(/^0/, "");

  document.querySelectorAll<HTMLElement>("[data-hl-trap]").forEach((fig) => {
    const buttons = fig.querySelectorAll<HTMLButtonElement>(".hlt-btn");
    const apply = (mode: string) => {
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.mode === mode)));
      fig.querySelectorAll<HTMLElement>(".hlt-row").forEach((row) => {
        const raw = row.dataset[mode as "any" | "rate"];
        if (!raw) return;
        const v = raw.split(",").map(Number);
        const bar = row.querySelector<HTMLElement>(".hlt-bar");
        const ci = row.querySelector<HTMLElement>(".hlt-ci");
        const val = row.querySelector<HTMLElement>(".hlt-val");
        if (bar) {
          bar.style.left = `${pos(Math.min(0, v[0])).toFixed(2)}%`;
          bar.style.width = `${Math.abs(pos(v[0]) - pos(0)).toFixed(2)}%`;
        }
        if (ci) {
          ci.style.left = `${pos(v[1]).toFixed(2)}%`;
          ci.style.width = `${(pos(v[2]) - pos(v[1])).toFixed(2)}%`;
        }
        if (val) val.textContent = `r = ${fmt(v[0])} [${fmt(v[1])}, ${fmt(v[2])}]`;
        const refLabel = row.querySelector<HTMLElement>(".hlt-ref-label");
        if (refLabel) refLabel.textContent = mode === "any" ? row.dataset.labelAny ?? "" : row.dataset.labelRate ?? "";
      });
      fig.querySelector<HTMLElement>("[data-note-any]")?.toggleAttribute("hidden", mode !== "any");
      fig.querySelector<HTMLElement>("[data-note-rate]")?.toggleAttribute("hidden", mode !== "rate");
    };
    buttons.forEach((b) => b.addEventListener("click", () => apply(b.dataset.mode ?? "any")));
  });
</script>

<style>
  .hlt { margin: 2rem 0; }
  .hlt-toggle { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1.25rem; }
  .hlt-btn {
    font-family: var(--font-mono); font-size: var(--fs-label); letter-spacing: .06em; text-transform: uppercase;
    padding: .55rem .9rem; background: transparent; color: inherit; cursor: pointer;
    border: 1px solid color-mix(in srgb, currentColor 30%, transparent);
  }
  .hlt-btn[aria-pressed="true"] { background: #3866A0; border-color: #3866A0; color: #fff; }
  .hlt-btn:focus-visible { outline: 2px solid #3866A0; outline-offset: 2px; }
  .hlt-axis, .hlt-row { display: grid; grid-template-columns: minmax(9rem, 14rem) 1fr 11rem; gap: .9rem; align-items: center; }
  .hlt-scale { position: relative; height: 1.1rem; }
  .hlt-scale span { position: absolute; transform: translateX(-50%); font-family: var(--font-mono); font-size: var(--fs-caption); opacity: .65; }
  .hlt-row { margin: .55rem 0; }
  .hlt-label { font-size: var(--fs-body-sm); line-height: 1.35; }
  .hlt-label small { display: block; font-family: var(--font-mono); font-size: var(--fs-caption); letter-spacing: .06em; text-transform: uppercase; opacity: .6; margin-top: .15rem; }
  .hlt-track { position: relative; height: 1.1rem; background: color-mix(in srgb, currentColor 7%, transparent); }
  .hlt-zero { position: absolute; top: -.2rem; bottom: -.2rem; width: 1px; background: color-mix(in srgb, currentColor 55%, transparent); }
  .hlt-bar { position: absolute; top: .2rem; height: .7rem; transition: left .45s var(--ease-standard, ease), width .45s var(--ease-standard, ease); }
  .hlt-bar.helper { background: #3866A0; }
  .hlt-bar.claimant { background: #B33A4A; }
  .hlt-bar.ref { background: color-mix(in srgb, currentColor 35%, transparent); }
  .hlt-ci { position: absolute; top: 50%; height: 2px; margin-top: -1px; background: currentColor; opacity: .85; transition: left .45s var(--ease-standard, ease), width .45s var(--ease-standard, ease); }
  .hlt-ci::before, .hlt-ci::after { content: ""; position: absolute; top: -4px; width: 1px; height: 10px; background: currentColor; }
  .hlt-ci::before { left: 0; }
  .hlt-ci::after { right: 0; }
  .hlt-val { font-family: var(--font-mono); font-size: var(--fs-label); }
  .hlt-ref { margin-top: 1.1rem; padding-top: .9rem; border-top: 1px dashed color-mix(in srgb, currentColor 25%, transparent); }
  .hlt figcaption { margin-top: 1.2rem; font-size: var(--fs-body-sm); line-height: 1.6; opacity: .85; }
  .hlt-note { display: block; margin-bottom: .5rem; }
  .hlt-note[hidden] { display: none; }
  @media (max-width: 640px) {
    .hlt-axis { display: none; }
    .hlt-row { grid-template-columns: 1fr; gap: .3rem; }
  }
  @media (prefers-reduced-motion: reduce) { .hlt-bar, .hlt-ci { transition: none; } }
</style>
